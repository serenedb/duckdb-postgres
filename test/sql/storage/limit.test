# name: test/sql/storage/limit.test
# description: Test limit on an attached table
# group: [storage]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES)

statement ok
CREATE OR REPLACE TABLE s.large_tbl AS FROM range(100000) t(i)

query I
FROM s.large_tbl LIMIT 5
----
0
1
2
3
4

query I
FROM s.large_tbl LIMIT 5 OFFSET 5
----
5
6
7
8
9

# limit is sent down to Postgres -- verify via PostgresQueryLog rather than EXPLAIN
# inspection, since our DuckDB fork emits a single-column QUERY PLAN
# (internal-36) which makes the upstream `query II EXPLAIN ... <!REGEX>` form
# unworkable.
statement ok
CALL enable_logging('PostgresQueryLog')

statement ok
FROM s.large_tbl LIMIT 5

query I
SELECT bool_or(query LIKE '%large_tbl%LIMIT 5%') FROM duckdb_logs_parsed('PostgresQueryLog')
----
true

statement ok
set pg_pages_per_task=1

query I
FROM s.large_tbl LIMIT 5
----
0
1
2
3
4

query I
FROM s.large_tbl LIMIT 5 OFFSET 5
----
5
6
7
8
9

# limit is pushed down to Postgres even with pg_pages_per_task=1
# (we force single-task execution when LIMIT is pushed down)
statement ok
FROM s.large_tbl LIMIT 5

query I
SELECT bool_or(query LIKE '%large_tbl%LIMIT 5%') FROM duckdb_logs_parsed('PostgresQueryLog')
----
true
